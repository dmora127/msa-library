# af3-cache — Jetstream2 API env (docker-compose.api.yml: api, pgweb, caddy).
#
#   cp .env.api.example .env.api
#   # generate the secrets:
#   openssl rand -hex 32      # -> API_KEYS       (hand this to OSPool submitters)
#   openssl rand -hex 32      # -> ADMIN_API_KEY  (keep this one)
#   openssl rand -hex 16      # -> PGWEB_AUTH_PASS
#   chmod 600 .env.api
#
# .env.api is gitignored and lives ONLY on the VM. Copy the two API keys
# somewhere safe when you generate them — nothing else stores them.

# --- job + admin auth (CHANGE_ME) -------------------------------------------
# API_KEYS is a comma-separated set: add the new key, restart api, hand it out,
# then drop the old one. ADMIN_API_KEY gates /v1/admin/*.
API_KEYS=CHANGE_ME_openssl_rand_hex_32
ADMIN_API_KEY=CHANGE_ME_openssl_rand_hex_32

# --- swappable implementations ----------------------------------------------
# Start on dryrun/dryrun (the API runs the full lifecycle but only LOGS the
# pelican commands it would run). Flip both to `pelican` once the OSDF
# credentials below are mounted and proven — see docs/README-phase2.md §7.
TOKEN_ISSUER_IMPL=pelican
OSDF_CLIENT_IMPL=pelican

# --- pelican CLI ------------------------------------------------------------
# The binary is BAKED INTO the image by the Dockerfile's `pelican` stage
# (PELICAN_VERSION build arg in docker-compose.api.yml). Never bind-mount a
# host pelican over this path — it would shadow the pinned binary. Only the
# credentials are mounted, read-only, at runtime.
PELICAN_TOKEN_BINARY=/usr/local/bin/pelican
OSDF_PELICAN_BINARY=/usr/local/bin/pelican
# Namespace registry: every OSDF namespace uploads may land in, with its token
# issuer URL, private-key path and capacity (see namespaces.yaml.example; copy
# it to namespaces.yaml next to this file — docker-compose.api.yml mounts it at
# the path below). Replaces PELICAN_TOKEN_ISSUER / PELICAN_TOKEN_PRIVATE_KEY /
# PELICAN_STORE_NAMESPACES. Required for TOKEN_ISSUER_IMPL=pelican: the api
# refuses to start without a valid file. More than one namespace only spreads
# writes when OSDF_NAMESPACE_TEMPLATE contains {namespace}.
PELICAN_NAMESPACES_FILE=/etc/af3cache/namespaces.yaml
# Seconds the per-namespace usage snapshot (capacity gate) is cached in-process.
# NAMESPACE_USAGE_TTL_SECONDS=60

# --- public edge (Caddy) ----------------------------------------------------
# PUBLIC_HOST is the hostname Caddy serves and requests a cert for. With no
# domain, <floating-ip>.sslip.io resolves to the IP with zero DNS setup.
# CADDY_TLS holds the literal tls directive:
#   `tls internal`      Caddy's local CA — clients need -k / the local CA.
#                       Required for sslip.io, which Let's Encrypt rate-limits.
#   (empty)             automatic Let's Encrypt — real domain only.
#   `tls you@your.edu`  ACME with that contact address.
PUBLIC_HOST=CHANGE_ME.sslip.io
CADDY_TLS=tls internal
# PUBLIC_HOST_ALT: a second, API-only hostname for a real domain you own (no
# Grafana/pgweb -- see the Caddyfile's `(api)` snippet). Always uses Caddy's
# normal automatic HTTPS (no CADDY_TLS-style toggle needed) since a real
# domain isn't rate-limit-shared the way sslip.io is.
#
# NOT truly optional as shipped: the Caddyfile always renders a
# `{$PUBLIC_HOST_ALT} { ... }` block, and Caddy fails to parse the ENTIRE
# file -- taking down PUBLIC_HOST too -- if this is empty or unset
# ("server block without any key is global configuration"), verified via
# `caddy validate`. If you don't have a second domain yet, delete the whole
# `{$PUBLIC_HOST_ALT} { ... }` block from the Caddyfile rather than leaving
# this blank.
PUBLIC_HOST_ALT=CHANGE_ME.your-domain.example

# --- diamond classifier -----------------------------------------------------
# noop | stub | diamond. Paths are in-container, from the /opt/diamond:ro bind
# mount; /opt/diamond MUST exist on the host even for noop (empty dir is fine).
CLASSIFIER_IMPL=diamond
DIAMOND_BINARY=/opt/diamond/diamond
DIAMOND_DB=/opt/diamond/swissprot_db/swissprot

# --- MMseqs2 similarity search (POST /v2/query similarity_search=true) -------
# mmseqs is baked into the api image (Dockerfile `mmseqs` stage), so no host
# install or bind mount is needed for the binary. SIMILARITY_DB_ROOT is the
# in-container path of the rw bind mount /mnt/pgdata/similarity (see
# docker-compose.api.yml); it only matters in snapshot mode.
#
# ephemeral mode (default) rebuilds the whole target DB PER REQUEST from the
# active table. Measured 2026-09-04 on the production table (597k sequences):
# dump 1.8 s, createdb 2.1 s, search 0.3 s at ~0.3 GB RSS -- but createindex
# adds 31 s and 1.8 GB RSS for IDENTICAL hits, which does not fit the api
# container's mem_limit of 2g. So the per-request index is OFF here (the code
# default is on, per spec). Budget ~0.3 GB RAM + ~0.55 GB of container /tmp
# per concurrent slot; the queue timeout returns 503 when all slots are busy.
SIMILARITY_SEARCH_ENABLED=true
SIMILARITY_DB_MODE=ephemeral
SIMILARITY_DB_ROOT=/var/lib/af3cache/similarity
SIMILARITY_MMSEQS_BINARY=/usr/local/bin/mmseqs
SIMILARITY_MMSEQS_THREADS=1
SIMILARITY_MAX_CONCURRENT=3
SIMILARITY_MMSEQS_SPLIT_MEMORY_LIMIT=1G
SIMILARITY_EPHEMERAL_INDEX=false
# SIMILARITY_QUEUE_TIMEOUT_SECONDS=30
# SIMILARITY_MIN_PERCENT_IDENTITY=90
# SIMILARITY_MIN_QUERY_COVERAGE=0.9
# SIMILARITY_MIN_TARGET_COVERAGE=0.9
# SIMILARITY_MAX_HITS=5
# Snapshot mode: run the nightly ONCE (helpers/similarity_nightly.sh) before
# setting SIMILARITY_DB_MODE=snapshot, then install both cron lines
# (docs/redeploy.md, Phase 9).
# SIMILARITY_NIGHTLY_BUILD_ENABLED=false
# SIMILARITY_DELTA_BUILD_ENABLED=false
# SIMILARITY_DELTA_REFRESH_MINUTES=60
# SIMILARITY_NIGHTLY_RETENTION_MINUTES=60
# SIMILARITY_DELTA_RETENTION_MINUTES=60

# --- NR BLAST reclassification (POST /v1/admin/classification/jobs/...) ----
# The api exports the pending set, scp's it to the BLAST box and runs
# reclass-submit / reclass-status there over ssh (helpers/reclassify_*.sh are
# just curl wrappers on cron). Key + known_hosts are the read-only mounts in
# docker-compose.api.yml; see docs/redeploy.md "Reclassification export" for
# generating/registering them. Tool paths are absolute: ~/.local/bin is not on
# a non-interactive ssh PATH.
RECLASS_EXPORT_MIN_LENGTH=30          # aa; shorter pending rows stay pending
RECLASS_REMOTE=exouser@<blast-box-ip>
RECLASS_REMOTE_DATA_DIR=/media/volume/mmseq2-data
RECLASS_REMOTE_SUBMIT=/home/exouser/.local/bin/reclass-submit
RECLASS_REMOTE_STATUS=/home/exouser/.local/bin/reclass-status
RECLASS_SSH_KEY_FILE=/keys/reclass_ed25519
RECLASS_KNOWN_HOSTS_FILE=/keys/reclass_known_hosts
# RECLASS_SSH_TIMEOUT_SECONDS=120
# RECLASS_SCP_TIMEOUT_SECONDS=600

# --- pgweb DB console (https://$PUBLIC_HOST/webdbinterface) ------------------
# HTTP basic auth, because a browser URL can't carry the API's X-API-Key
# header. PGWEB_DATABASE_URL is plain postgres:// (not +asyncpg) and its
# password must match POSTGRES_PASSWORD in .env.prod.
PGWEB_AUTH_USER=admin
PGWEB_AUTH_PASS=CHANGE_ME_openssl_rand_hex_16
PGWEB_DATABASE_URL=postgres://af3:CHANGE_ME_same_as_POSTGRES_PASSWORD@db:5432/af3cache?sslmode=disable

# Caddy basic_auth gate in front of Grafana at /grafana. Generate the hash with:
#   docker run --rm caddy:2 caddy hash-password --plaintext '<password>'
GRAFANA_PROXY_USER=admin
GRAFANA_PROXY_HASH=CHANGE_ME_bcrypt_hash_from_caddy_hash_password

# Prometheus /metrics endpoint. Blocked at the edge by the Caddyfile;
# Prometheus scrapes api:8000 directly on the compose network.
# Set false to remove the metrics middleware and endpoint entirely.
METRICS_ENABLED=true
