# af3-cache monitoring stack — copy to .env.monitoring and fill in.
#   cp .env.monitoring.example .env.monitoring && chmod 600 .env.monitoring
#
# The real file is gitignored (.env* in .gitignore). This template is not.

# --- postgres-exporter -------------------------------------------------------
# Create the least-privilege role first (psql as the app user):
#   CREATE ROLE af3_exporter LOGIN PASSWORD '<openssl rand -hex 24>';
#   GRANT pg_monitor TO af3_exporter;
#   GRANT CONNECT ON DATABASE af3cache TO af3_exporter;
#   GRANT USAGE ON SCHEMA public TO af3_exporter;
#   GRANT SELECT ON public.msa_cache_entries, public.msa_ingestions,
#                   public.msa_sources, public.query_metrics TO af3_exporter;
# NOTE: role names starting with "pg_" are RESERVED by Postgres -- hence af3_.
# Do NOT reuse the app's af3 role: it is the service role and bypasses RLS.
DATA_SOURCE_NAME=postgresql://af3_exporter:CHANGE_ME@db:5432/af3cache?sslmode=disable

# --- grafana -----------------------------------------------------------------
# Grafana will not start with an empty admin password.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_openssl_rand_hex_16

# Unified alerting via SMTP. Reuse the same send-only relay account cron uses
# (see ~/.msmtprc) or issue a second app password so the two can be revoked
# independently.
GF_SMTP_ENABLED=true
GF_SMTP_HOST=smtp.gmail.com:587
GF_SMTP_USER=CHANGE_ME@gmail.com
GF_SMTP_PASSWORD=CHANGE_ME_16_CHAR_APP_PASSWORD
GF_SMTP_FROM_ADDRESS=CHANGE_ME@gmail.com
GF_SMTP_FROM_NAME=af3cache monitoring
GF_SMTP_STARTTLS_POLICY=OpportunisticStartTLS

# Where alerts are delivered.
ALERT_EMAIL=you@example.edu

# Grafana is served under a sub-path behind Caddy. Must match the Caddy route
# and your PUBLIC_HOST from .env.api.
GF_SERVER_ROOT_URL=https://CHANGE_ME_PUBLIC_HOST/grafana/
