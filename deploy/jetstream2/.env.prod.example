# af3-cache — Jetstream2 DATABASE env (docker-compose.prod.yml).
#
#   cp .env.prod.example .env.prod
#   PW=$(openssl rand -base64 32 | tr -d '/+=' | cut -c1-32)
#   sed -i "s#CHANGE_ME_use_openssl_rand#${PW}#g" .env.prod
#   chmod 600 .env.prod
#
# .env.prod is gitignored — the password lives ONLY here and in your backups.
# DATABASE_URL uses host `db` (the compose service name); from the VM host
# itself swap it for 127.0.0.1. Postgres binds 127.0.0.1 only and is never
# internet-exposed.

POSTGRES_USER=af3
POSTGRES_PASSWORD=CHANGE_ME_use_openssl_rand
POSTGRES_DB=af3cache
DATABASE_URL=postgresql+asyncpg://af3:CHANGE_ME_use_openssl_rand@db:5432/af3cache
