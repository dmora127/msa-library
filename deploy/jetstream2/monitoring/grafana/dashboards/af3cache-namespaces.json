{
  "uid": "af3cache-namespaces",
  "title": "af3-cache namespaces",
  "description": "Per-OSDF-namespace capacity: registry (namespaces.yaml) vs live usage from msa_ingestions.",
  "tags": [
    "af3cache"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h",
      "2h",
      "1d"
    ]
  },
  "editable": true,
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "af3cache-prom"
        },
        "query": {
          "query": "label_values(af3cache_namespace_capacity_bytes, namespace)",
          "refId": "ns"
        },
        "definition": "label_values(af3cache_namespace_capacity_bytes, namespace)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Namespaces (registry + live usage)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "table",
      "title": "Namespaces",
      "description": "One row per entry in namespaces.yaml. used = published objects (observed bytes, reaped ones excluded) + in-flight rows at their DECLARED size. The gate refuses NEW uploads once headroom % <= 'gate at %'; re-requests of existing rows are never refused. Bytes come from postgres-exporter; capacity/enabled/accepting from the app registry.",
      "datasource": {
        "type": "prometheus",
        "uid": "af3cache-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "af3cache-prom"
          },
          "editorMode": "code",
          "expr": "sum by (namespace) (af3cache_namespace_enabled)",
          "legendFormat": "__auto",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "af3cache-prom"
          },
          "editorMode": "code",
          "expr": "sum by (namespace) (af3cache_namespace_accepting)",
          "legendFormat": "__auto",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "af3cache-prom"
          },
          "editorMode": "code",
          "expr": "sum by (namespace) (af3cache_namespace_available_count or af3cache_namespace_capacity_bytes * 0)",
          "legendFormat": "__auto",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "af3cache-prom"
          },
          "editorMode": "code",
          "expr": "sum by (namespace) (af3cache_namespace_inflight_count or af3cache_namespace_capacity_bytes * 0)",
          "legendFormat": "__auto",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "af3cache-prom"
          },
          "editorMode": "code",
          "expr": "sum by (namespace) (af3cache_namespace_used_bytes or af3cache_namespace_capacity_bytes * 0)",
          "legendFormat": "__auto",
          "refId": "E",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "af3cache-prom"
          },
          "editorMode": "code",
          "expr": "sum by (namespace) (af3cache_namespace_capacity_bytes)",
          "legendFormat": "__auto",
          "refId": "F",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "af3cache-prom"
          },
          "editorMode": "code",
          "expr": "sum by (namespace) (af3cache_namespace_capacity_bytes) - sum by (namespace) (af3cache_namespace_used_bytes or af3cache_namespace_capacity_bytes * 0)",
          "legendFormat": "__auto",
          "refId": "G",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "af3cache-prom"
          },
          "editorMode": "code",
          "expr": "(sum by (namespace) (af3cache_namespace_capacity_bytes) - sum by (namespace) (af3cache_namespace_used_bytes or af3cache_namespace_capacity_bytes * 0)) / sum by (namespace) (af3cache_namespace_capacity_bytes) * 100",
          "legendFormat": "__auto",
          "refId": "H",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "af3cache-prom"
          },
          "editorMode": "code",
          "expr": "sum by (namespace) (af3cache_namespace_min_headroom_pct)",
          "legendFormat": "__auto",
          "refId": "I",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "namespace",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "Time 6": true,
              "Time 7": true,
              "Time 8": true,
              "Time 9": true,
              "Time": true
            },
            "renameByName": {
              "Value #A": "enabled",
              "Value #B": "accepting",
              "Value #C": "available",
              "Value #D": "in-flight",
              "Value #E": "used",
              "Value #F": "capacity",
              "Value #G": "headroom",
              "Value #H": "headroom %",
              "Value #I": "gate at %"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "headroom %",
            "desc": false
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "used"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "capacity"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "headroom"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "headroom %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 10
                    },
                    {
                      "color": "green",
                      "value": 20
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "gate at %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "enabled"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "no",
                        "color": "red",
                        "index": 0
                      },
                      "1": {
                        "text": "yes",
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "accepting"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
