# TLS mode is env-driven so re-syncing this file never breaks a running VM.
# CADDY_TLS (set in .env.api) holds the literal tls directive:
#   CADDY_TLS=tls internal   -> Caddy local CA (sslip.io / no trusted domain).
#                               Clients need -k / the local CA. PoC only.
#   CADDY_TLS=                -> empty: automatic Let's Encrypt for PUBLIC_HOST
#                               (use only with a real domain you control —
#                               sslip.io is LE-rate-limited).
#   CADDY_TLS=tls you@example.com  -> ACME with that contact email.
#
# PUBLIC_HOST + CADDY_TLS come from .env.api (preserved on the VM, never
# rsynced), so this committed file is safe to overwrite on every deploy.

{$PUBLIC_HOST} {
	{$CADDY_TLS}
	encode gzip

	# Admin DB console. pgweb runs with --prefix=webdbinterface, so it expects
	# the prefix in the path -> forward it unchanged (handle, not handle_path).
	# Auth is pgweb's own HTTP basic auth (PGWEB_AUTH_USER/PASS), prompted by the
	# browser. handle blocks are mutually exclusive and matched top-down.
	@webdb path /webdbinterface /webdbinterface/*
	handle @webdb {
		reverse_proxy pgweb:8081
	}

	# Grafana monitoring dashboards. Two gates on purpose: Caddy basic_auth as
	# an outer gate, and Grafana's own login inside. GF_AUTH_PROXY is deliberately
	# NOT used -- misconfigured header-trust auth is a real bypass, and the small
	# friction of two logins is worth more than that risk on a public path.
	#
	# `handle` (not handle_path) keeps the /grafana prefix, which is what
	# GF_SERVER_SERVE_FROM_SUB_PATH=true in .env.monitoring expects -- same
	# arrangement as pgweb's --prefix above. Drop either and every asset 404s.
	#
	# NOTE: while CADDY_TLS=tls internal the browser cannot validate this cert,
	# so the Grafana password is typed into an unauthenticated page. Use a
	# password that is not reused anywhere else until the real cert lands.
	@grafana path /grafana /grafana/*
	handle @grafana {
		basic_auth {
			{$GRAFANA_PROXY_USER} {$GRAFANA_PROXY_HASH}
		}
		reverse_proxy grafana:3000 {
			# CRITICAL: basic_auth does NOT consume the Authorization header, so
			# without this Grafana receives the CADDY credentials, tries to log in
			# with them, fails on every request, and trips its brute-force lockout
			# ("too many consecutive incorrect login attempts") -- locking the real
			# admin out. Strip it so Grafana sees a clean request and uses its own
			# cookie session instead.
			header_up -Authorization
		}
	}

	# Internal-only endpoints. Prometheus scrapes api:8000 directly on the compose
	# network, so these never need to traverse the edge. Responds 404 rather than
	# 403 so their existence is not advertised.
	#
	# /metrics exposes route names, error-code distribution, upload volumes and DB
	# pool sizing -- not credentials, but useful reconnaissance. /readyz arrives in
	# phase 4 and is listed now so both land in a single Caddy recreate.
	#
	# NOTE: without this block the catch-all below would proxy them straight to
	# api:8000, i.e. world-readable the moment the endpoint exists.
	@internal path /metrics /metrics/* /readyz
	handle @internal {
		respond 404
	}

	# Everything else is the API.
	#
	# CORS is owned by the APP (app/main.py, CORSMiddleware), not by this file,
	# so the origin allowlist lives with the code and covers only the public
	# read endpoints (/v1/stats, /v1/query).
	#
	# The edge-CORS version is kept below, commented out, in case we ever want
	# to move it back here (e.g. to keep serving CORS headers when the app is
	# down or 500ing, which the app-side version cannot do). If you re-enable
	# it, REMOVE or narrow the CORSMiddleware block in app/main.py first —
	# running both is the trap:
	#   - Caddy's `header` directive REPLACES the upstream value, so this would
	#     silently widen the app's allowlist back to "*";
	#   - `respond @options 204` answers preflights before the app sees them,
	#     making the app's allow_methods/allow_headers dead config.
	#
	# handle {
	# 	header {
	# 		Access-Control-Allow-Origin "*"
	# 		Access-Control-Allow-Methods "GET, POST, OPTIONS"
	# 		Access-Control-Allow-Headers "Content-Type, X-API-Key, Authorization"
	# 		Access-Control-Max-Age "86400"
	# 	}
	# 	# Short-circuit the CORS preflight (browser sends OPTIONS before the
	# 	# real POST) so it never reaches the API.
	# 	@options method OPTIONS
	# 	respond @options 204
	#
	# 	reverse_proxy api:8000
	# }
	handle {
		reverse_proxy api:8000
	}
}
