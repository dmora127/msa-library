# af3-cache — local development environment. Copy to .env and adjust.
#
#   docker compose up -d          # Postgres 16 on localhost:5432
#   cp .env.example .env
#   uv sync && uv run alembic upgrade head
#   uv run uvicorn app.main:app --reload
#
# Every key here is optional — app/core/config.py carries a working default for
# all of them. This file documents the ones you actually tune locally. Values
# marked CHANGE_ME must be replaced before this config is used anywhere real.
# Runtime-adjustable values (max upload size, token TTL, namespace template,
# reap grace) are overridden by app_settings rows via PUT /v1/admin/config;
# env is only the floor.

# --- database ---------------------------------------------------------------
# Matches docker-compose.yml (user/password/db all `af3`/`af3`/`af3cache`).
DATABASE_URL=postgresql+asyncpg://af3:af3@localhost:5432/af3cache

# --- auth -------------------------------------------------------------------
# Comma-separated set, so keys can be rotated without downtime. ADMIN_API_KEY
# gates /v1/admin/*; if unset it falls back to the first API_KEYS entry.
API_KEYS=dev-key-change-me
ADMIN_API_KEY=dev-admin-key-change-me

# --- swappable implementations ----------------------------------------------
# TOKEN_ISSUER_IMPL  stub | dryrun | inprocess | pelican | local | oauth2
#   stub    tests
#   dryrun  logs the `pelican token create` it *would* run, returns a fake token
#   inprocess production: signs the WLCG write token in process with the
#           namespace registry's key (same claims/kid as pelican, no network)
#   pelican production fallback: shells out to `pelican token create`
#   local   self-signed SciToken/WLCG JWT + a /.well-known/jwks.json mount
#           (needs TOKEN_SIGNING_KEY or TOKEN_SIGNING_KEY_FILE)
#   oauth2  v0.2 — raises NotImplementedError in v0.1
# OSDF_CLIENT_IMPL   stub | dryrun | pelican
# CLASSIFIER_IMPL    noop | stub | diamond   (diamond requires the binary + DB below)
TOKEN_ISSUER_IMPL=dryrun
OSDF_CLIENT_IMPL=dryrun
CLASSIFIER_IMPL=noop

# --- OSDF object placement --------------------------------------------------
# The template may interpolate {namespace} (picked at random from the enabled
# entries of the namespace registry that still have capacity headroom),
# {seq_hash}, {source_slug} and {ingestion_id}.
# A pelican://<host>/... URL resolves <host> as a *federation* hostname, so a
# bare namespace name belongs in the path — as the osdf:/// form does.
OSDF_NAMESPACE_TEMPLATE=osdf:///af3-msa-library/community-contributed/{ingestion_id}.a3m
# Namespace registry (YAML): namespace -> issuer URL, private key, capacity_tb,
# enabled. See deploy/jetstream2/namespaces.yaml.example. Required (validated
# at startup) when TOKEN_ISSUER_IMPL is pelican or inprocess; an absent file is
# tolerated by dryrun/local/stub, which then treat the registry as empty.
# PELICAN_NAMESPACES_FILE=./namespaces.yaml
# NAMESPACE_USAGE_TTL_SECONDS=60

# --- operational limits (overridable at runtime via /v1/admin/config) --------
MAX_UPLOAD_SIZE_BYTES=104857600
TOKEN_TTL_SECONDS=1200
REAP_GRACE_HOURS=12
ACCESS_BUMP_GRANULARITY_SECONDS=86400

# --- diamond classifier (only when CLASSIFIER_IMPL=diamond) ------------------
# DIAMOND_BINARY=/opt/diamond/diamond
# DIAMOND_DB=/opt/diamond/swissprot_db/swissprot

# --- MMseqs2 similarity search (POST /v2/query similarity_search=true) -------
# Opt-in neighbour lookup after an exact miss. Needs an `mmseqs` binary (baked
# into the Docker image; locally point SIMILARITY_MMSEQS_BINARY at a static
# release build). All of these are env-only.
# SIMILARITY_DB_MODE  ephemeral | snapshot
#   ephemeral  per request: dump active sequences -> createdb -> createindex ->
#              search -> delete the workspace (default; nothing to operate)
#   snapshot   search the indexed nightly generation + the hot delta under
#              SIMILARITY_DB_ROOT; requires the builders below and a cron
#              (deploy/jetstream2/helpers/similarity_{nightly,delta}.sh)
# SIMILARITY_SEARCH_ENABLED=true
# SIMILARITY_DB_MODE=ephemeral
# SIMILARITY_MMSEQS_BINARY=mmseqs
# SIMILARITY_MMSEQS_THREADS=4
# SIMILARITY_MAX_CONCURRENT=4
# Thresholds: identity 0-100, coverages 0-1 (query AND target, separately).
# SIMILARITY_MIN_PERCENT_IDENTITY=90
# SIMILARITY_MIN_QUERY_COVERAGE=0.9
# SIMILARITY_MIN_TARGET_COVERAGE=0.9
# SIMILARITY_MAX_HITS=5
# Snapshot-mode builders: implemented, DISABLED until you flip these.
# SIMILARITY_DB_ROOT=/var/lib/af3cache/similarity
# SIMILARITY_NIGHTLY_BUILD_ENABLED=false
# SIMILARITY_DELTA_BUILD_ENABLED=false
# SIMILARITY_DELTA_REFRESH_MINUTES=60
# SIMILARITY_NIGHTLY_RETENTION_MINUTES=60
# SIMILARITY_DELTA_RETENTION_MINUTES=60

# --- NR BLAST reclassification -----------------------------------------------
# GET /v1/admin/classification/pending.fa never exports sequences shorter than
# this many residues (overridable per request with ?min_length=).
# RECLASS_EXPORT_MIN_LENGTH=30
# POST /v1/admin/classification/jobs/submit and .../poll ssh to the BLAST box;
# locally you almost certainly want these to point at a box you can reach, or
# leave them and expect 503 reclass_remote_unavailable from those two routes.
# RECLASS_REMOTE=exouser@<blast-box-ip>
# RECLASS_REMOTE_DATA_DIR=/media/volume/mmseq2-data
# RECLASS_REMOTE_SUBMIT=/home/exouser/.local/bin/reclass-submit
# RECLASS_REMOTE_STATUS=/home/exouser/.local/bin/reclass-status
# RECLASS_SSH_KEY_FILE=              # unset = ssh's default identities
# RECLASS_KNOWN_HOSTS_FILE=          # unset = StrictHostKeyChecking=accept-new

# --- pelican CLI (TOKEN_ISSUER_IMPL=pelican and/or OSDF_CLIENT_IMPL=pelican) --
# PELICAN_TOKEN_BINARY=/usr/local/bin/pelican
# OSDF_PELICAN_BINARY=/usr/local/bin/pelican
# issuer URL + private key per namespace live in PELICAN_NAMESPACES_FILE (above)
# for both the inprocess and the pelican issuer.

# Prometheus /metrics endpoint. Blocked at the edge by the Caddyfile;
# Prometheus scrapes api:8000 directly on the compose network.
# Set false to remove the metrics middleware and endpoint entirely.
METRICS_ENABLED=true
