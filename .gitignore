.venv/
__pycache__/
*.pyc
.env
.pytest_cache/
.ruff_cache/
*.sqlite
.coverage
htmlcov/
dist/
build/
*.egg-info/
.DS_Store
*.pem
.env*
*.env*
# local agent settings (mirrors .dockerignore)
.claude/

# stray credential artifacts
tok.en
*.jwt

# msmtp relay credentials. Config now lives with the rest of the deploy config
# in deploy/jetstream2/, but the filename does NOT match the .env* patterns
# above, so it must be listed explicitly or the SMTP app password gets committed.
.msmtprc
*/.msmtprc
**/.msmtprc

# healthchecks.io dead-man's-switch ping URLs (anyone holding these can forge
# "all is well" pings). Matches *.env* already; listed for clarity.
.af3cache-monitoring.env
**/.af3cache-monitoring.env

# OSDF namespace registry (issuer URLs + key paths + capacities). The real
# file is per-deployment; only the .example template is committed.
namespaces.yaml
deploy/jetstream2/namespaces.yaml

# ...but the committed templates are not secrets
!*.example

# bulk FASTA exports dropped in the repo root (nightly_library_build.fa,
# sequences.fasta): hundreds of MB, never to be committed. Root-only pattern so
# small fixtures under tests/ stay committable.
/*.fa
/*.fasta
